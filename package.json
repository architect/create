{
  "name": "@architect/create",
  "version": "7.0.0",
  "description": "Idempotently initialize Architect projects",
  "main": "src/index.js",
  "bin": {
    "arc-create": "src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/architect/create.git"
  },
  "scripts": {
    "test": "npm run lint && npm run test:integration && npm run coverage",
    "test:nolint": "npm run test:integration && npm run coverage",
    "test:unit": "node --test 'test/unit/**/*-test.js'",
    "test:integration": "node --test test/integration/cli-test.js",
    "coverage": "node --test --experimental-test-coverage 'test/unit/**/*-test.js' test/integration/cli-test.js",
    "lint": "eslint . --fix",
    "rc": "npm version prerelease --preid RC"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@architect/inventory": "~6.0.0",
    "@architect/utils": "~6.0.0"
  },
  "devDependencies": {
    "@architect/eslint-config": "~3.0.0",
    "eslint": "~9.36.0"
  }
}
